# Experimento 4x — copie para docker.env ou use: .\scripts\switch_experiment.ps1 4x

EXPERIMENT_LABEL=4x
EXECUTION_TIME_SECONDS=3600
RATE_MODIFIER=4

MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=factory/sensors
MQTT_CLIENT_ID=sensor-producer

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-token
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=iot_stream_4x
INFLUX_BATCH_SIZE=500
INFLUX_FLUSH_INTERVAL_MS=1000
STREAM_QUEUE_MAXSIZE=800000
STREAM_DRAIN_BATCH_SIZE=500
STREAM_DRAIN_TIMEOUT_S=1.0
STREAM_WORKER_COUNT=2
STREAM_METRICS_LOG_INTERVAL_S=60
MQTT_QOS=1
MQTT_MAX_INFLIGHT=80

PG_USER=grafana
PG_PASSWORD=grafana
PG_DB=iot_batch
PG_HOST=postgres
PG_PORT=5432
PG_PORT_HOST=5434
PG_TABLE=sensor_data_4x

BATCH_THRESHOLD=10000
BATCH_FLUSH_INTERVAL=60
BATCH_OUTPUT_DIR=/app/batches_output
BATCH_PROCESSED_DIR=/app/batches_processed
BATCH_OUTPUT_HOST=./batches_output_4x
BATCH_PROCESSED_HOST=./batches_processed_4x
# EXPERIMENT_RUN_DIR, METRICS_HOST — definidos por start_experiment.sh / init_experiment_run
