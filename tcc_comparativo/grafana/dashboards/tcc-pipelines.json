      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-batch" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  to_timestamp(created_at / 1000.0) AS \"time\",\n  COUNT(*)::double precision AS \"records_per_second\"\nFROM ${pg_table}\nWHERE created_at >= (EXTRACT(EPOCH FROM $__timeFrom()::timestamptz) * 1000)::bigint\n  AND created_at < (EXTRACT(EPOCH FROM $__timeTo()::timestamptz) * 1000)::bigint\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Batch — registros por segundo (created_at)",
      "type": "timeseries"
    },
