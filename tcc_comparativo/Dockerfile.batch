FROM python:3.12-slim

WORKDIR /app

# Instala cron + dependências Python
RUN apt-get update && apt-get install -y cron

COPY batch_crontab /etc/cron.d/batch_crontab
COPY cronjob_executor.py .
COPY sensors/ ./sensors/
COPY batch_consumer.py .
COPY requirements.txt .
COPY script_docker.sh .
COPY utils/ ./utils/
COPY logs/ ./logs/
COPY docker.env ./.env

RUN chmod 0644 /etc/cron.d/batch_crontab \
    && crontab /etc/cron.d/batch_crontab \
    && chmod +x script_docker.sh

RUN pip install --no-cache-dir -r requirements.txt

ENTRYPOINT ["./script_docker.sh"]