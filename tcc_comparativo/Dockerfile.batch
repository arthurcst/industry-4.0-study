FROM python:3.12-slim

WORKDIR /app

# Instala cron + bash + dependências Python
RUN apt-get update && apt-get install -y cron bash

COPY batch_crontab /etc/cron.d/batch_crontab
COPY cronjob_executor.py .
COPY sensors/ ./sensors/
COPY batch_consumer.py .
COPY requirements.txt .
COPY script_docker.sh .
COPY utils/ ./utils/

RUN mkdir -p /app/logs \
    && chmod 0644 /etc/cron.d/batch_crontab \
    && crontab /etc/cron.d/batch_crontab \
    && chmod +x script_docker.sh

RUN pip install --no-cache-dir -r requirements.txt

ENTRYPOINT ["/bin/bash", "/app/script_docker.sh"]