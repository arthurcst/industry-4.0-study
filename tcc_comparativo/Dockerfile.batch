FROM python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54

WORKDIR /app

# Instala cron + bash + dependências Python
RUN apt-get update && apt-get install -y cron bash

COPY batch_crontab /app/batch_crontab
COPY cronjob_executor.py .
COPY sensors/ ./sensors/
COPY batch_consumer.py .
COPY requirements.txt .
COPY script_docker.sh .
COPY utils/ ./utils/

RUN mkdir -p /app/logs \
    && sed -i 's/\r$//' /app/batch_crontab /app/script_docker.sh \
    && crontab /app/batch_crontab \
    && chmod +x script_docker.sh

RUN pip install --no-cache-dir -r requirements.txt

ENTRYPOINT ["/bin/bash", "/app/script_docker.sh"]
