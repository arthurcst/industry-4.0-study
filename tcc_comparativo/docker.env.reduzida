# Planta reduzida: 25 ativos industriais.

EXPERIMENT_LABEL=reduzida
EXECUTION_TIME_SECONDS=3600
ACTIVE_ASSET_COUNT=25
EXPERIMENT_SEED=20261101

MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=factory/sensors
MQTT_CLIENT_ID=sensor-producer

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-token
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=iot_stream_reduzida
INFLUX_BATCH_SIZE=5000
INFLUX_FLUSH_INTERVAL_MS=500
STREAM_QUEUE_MAXSIZE=200000
STREAM_DRAIN_BATCH_SIZE=3000
STREAM_DRAIN_TIMEOUT_S=0.05
STREAM_WORKER_COUNT=1
STREAM_METRICS_LOG_INTERVAL_S=60
MQTT_QOS=1
MQTT_MAX_INFLIGHT=20

PG_USER=grafana
PG_PASSWORD=grafana
PG_DB=iot_batch
PG_HOST=postgres
PG_PORT=5432
PG_PORT_HOST=5434
PG_TABLE=sensor_data_reduzida

BATCH_THRESHOLD=10000
BATCH_FLUSH_INTERVAL=60
BATCH_OUTPUT_DIR=/app/batches_output
BATCH_PROCESSED_DIR=/app/batches_processed
BATCH_OUTPUT_HOST=./batches_output_reduzida
BATCH_PROCESSED_HOST=./batches_processed_reduzida
# EXPERIMENT_RUN_DIR e METRICS_HOST são definidos por start_experiment.sh / init_experiment_run.
