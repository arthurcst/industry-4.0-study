# Experimento 2x — copie para docker.env ou use: .\scripts\switch_experiment.ps1 2x

EXPERIMENT_LABEL=2x
EXECUTION_TIME_SECONDS=3600
RATE_MODIFIER=2

MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=factory/sensors
MQTT_CLIENT_ID=sensor-producer

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-token
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=iot_stream_2x
INFLUX_BATCH_SIZE=8000
INFLUX_FLUSH_INTERVAL_MS=400
STREAM_QUEUE_MAXSIZE=500000
STREAM_DRAIN_BATCH_SIZE=5000
STREAM_DRAIN_TIMEOUT_S=0.03
STREAM_WORKER_COUNT=8
STREAM_METRICS_LOG_INTERVAL_S=60
MQTT_QOS=1
MQTT_MAX_INFLIGHT=50

PG_USER=grafana
PG_PASSWORD=grafana
PG_DB=iot_batch
PG_HOST=postgres
PG_PORT=5432
PG_PORT_HOST=5434
PG_TABLE=sensor_data_2x

BATCH_THRESHOLD=10000
BATCH_FLUSH_INTERVAL=60
BATCH_OUTPUT_DIR=/app/batches_output
BATCH_PROCESSED_DIR=/app/batches_processed
BATCH_OUTPUT_HOST=./batches_output_2x
BATCH_PROCESSED_HOST=./batches_processed_2x
# EXPERIMENT_RUN_DIR, METRICS_HOST — definidos por start_experiment.sh / init_experiment_run
